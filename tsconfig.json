{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"allowJs": true,
		"checkJs": false,
		"noEmit": true,
		"skipLibCheck": true,
		"strict": false,
		"noImplicitAny": false,
		"strictNullChecks": false,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"allowSyntheticDefaultImports": true,
		"forceConsistentCasingInFileNames": true,
		"isolatedModules": false
	},
	"include": ["src/**/*.js", "src/**/*.d.ts", "dashboard/**/*.js", "dashboard/**/*.d.ts"],
	"exclude": ["node_modules", "**/*.test.js", "src/.tmp/**", "src/commands/template.example.js"]
}
