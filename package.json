{
  "name": "aestherix",
  "version": "7.10.0",
  "description": "WhatsApp bot using Baileys library with Javascript language.",
  "exports": "./index.js",
  "main": "./index.js",
  "type": "module",
  "scripts": {
    "build": "npm run dashboard:build",
    "dashboard:install": "cd dashboard/client && npm install",
    "dashboard:dev": "cd dashboard/client && npm run dev",
    "dashboard:build": "cd dashboard/client && npm run build",
    "pm2": "pm2 start ./index.js -- nugraizy_android --watch --pair-mode --limit-reset --multi-cmd --cool-down && pm2 logs",
    "pm2:split": "pm2 start ecosystem.config.cjs",
    "pm2:split:logs": "pm2 logs aestherix-bot aestherix-dashboard",
    "pm2:split:stop": "pm2 stop aestherix-bot aestherix-dashboard",
    "pm2kill": "pm2 kill",
    "dev": "nodemon",
    "start": "node . nugraizy_android --watch --pair-mode --limit-reset --multi-cmd --cool-down",
    "start:bot": "node . nugraizy_android --watch --pair-mode --limit-reset --multi-cmd --cool-down",
    "start:dashboard": "node ./dashboard.js",
    "test": "node --test --test-reporter=spec --test-force-exit __tests__/",
    "lint": "eslint .",
    "lint:file": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:file": "prettier --write",
    "youtube:auth": "node ./src/utils/modules/youtube-auth.js",
    "nhentai:cookie": "node ./src/utils/doujin/cookies.js --get",
    "instagram:login": "node ./src/utils/instagram/instagram-login.js",
    "instagram:login:interactive": "node ./src/utils/instagram/instagram-login-interactive.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "db:push:mongo": "prisma db push --schema=prisma/schema.mongodb.prisma",
    "db:generate:mongo": "prisma generate --schema=prisma/schema.mongodb.prisma"
  },
  "keywords": [
    "whatsapp",
    "bot",
    "javascript",
    "nodejs",
    "baileys",
    "baileysbot",
    "baileysbotjs",
    "whatsappbot"
  ],
  "author": "nugraizy",
  "license": "MIT",
  "nodemonConfig": {
    "ignore": [
      "test/**",
      "*.json"
    ],
    "delay": 500
  },
  "engines": {
    "node": "20"
  },
  "dependencies": {
    "@atproto/api": "^0.13.32",
