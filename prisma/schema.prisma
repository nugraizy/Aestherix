// ─────────────────────────────────────────────────────────────────────────────
// Prisma Schema — Aestherix Bot
//
// Supported providers (set DATABASE_PROVIDER in .env):
//   "postgresql"  →  PostgreSQL / Supabase / Neon / Railway
//   "mysql"       →  MySQL / MariaDB / PlanetScale
//   "sqlite"      →  SQLite (local file, good for development)
//   "mongodb"     →  MongoDB Atlas / self-hosted
//
// NOTE for MySQL users: the `session` field on the Session model stores
// Baileys serialised state which can exceed varchar(191). Run
// `prisma migrate dev` and then manually ALTER TABLE to TEXT if you see
// truncation errors.
//
// NOTE for MongoDB users: `prisma migrate` is NOT supported; use
// `prisma db push` instead.  Alternatively, copy prisma/schema.mongodb.prisma
// to prisma/schema.prisma and run `prisma generate && prisma db push`.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = env("DATABASE_PROVIDER")
  url      = env("DATABASE_URL")
}


/// Stores Baileys signal-key state and credentials (one row per key/creds).
model Session {
  id        String   @id @default(cuid())
  sessionId String   @unique
  session   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Persisted Baileys in-memory store snapshot (per session).
model BaileysStore {
  id          String   @id @default(cuid())
  sessionName String   @unique
  state       String
  updatedAt   DateTime @updatedAt
}

/// Pinterest profile picture history entries.
model PinterestProfilePicture {
  id           String   @id @default(cuid())
  timestamp    String   @unique
  url          String
  thumbnail    String
  colorPalette String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}


/// Per-user command limit and subscription role.
model UserLimit {
  id          String   @id @default(cuid())
  jid         String
  sessionName String   @default("main")
  limit       Int      @default(30)
  /// FREE | PREMIUM | OWNER
  role        String   @default("FREE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([jid, sessionName])
}

/// Globally banned WhatsApp JIDs.
model BannedUser {
  id        String   @id @default(cuid())
  jid       String   @unique
  createdAt DateTime @default(now())
}

/// WhatsApp contact name cache.
model Contact {
  id          String   @id @default(cuid())
  jid         String
  sessionName String   @default("main")
  name        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([jid, sessionName])
}

/// Feature flags and settings for each WhatsApp group.
model SettingsManager {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  groupId          String
  sessionName      String   @default("main")
  groupName        String?
  groupDescription String?
  welcome          String   @default("disable")
  welcomeMessage   String   @default("Welcome to {groupName}")
  leave            String   @default("disable")
  leaveMessage     String   @default("Bye bye {groupName}")
  welcomeImage     String   @default("enable")
  antiDelete       String   @default("disable")
  antiGroupURL     String   @default("disable")
  antiURL          String   @default("disable")
  antiSpam         String   @default("disable")
  antiVirus        String   @default("disable")
  autoReader       String   @default("disable")
  antiNSFW         String   @default("disable")
  games            String   @default("disable")
  notification     String   @default("disable")
  /// JSON-encoded array of banned member JIDs within this group.
  bannedMembers    String   @default("[]")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([groupId, sessionName])
}

/// Web-dashboard login sessions.
model DashboardSession {
  id          String   @id @default(cuid())
  token       String   @unique
  /// owner | viewer
  role        String
  phoneNumber String?
  name        String?
  lastSeenAt  BigInt?
  expiresAt   BigInt?
  createdAt   DateTime @default(now())
}

/// Immutable audit trail of dashboard actions.
model DashboardAuditLog {
  id        String   @id @default(cuid())
  /// Sequential display ID (application-managed).
  logId     Int
  timestamp BigInt
  action    String
  actorRole String
  actor     String
  target    String?
  status    String
  message   String?
  /// JSON-serialised before/after snapshots.
  before    String?
  after     String?
  createdAt DateTime @default(now())
}

/// Blocked JIDs / IPs for the dashboard.
model DashboardBlocklist {
  id        String   @id @default(cuid())
  value     String   @unique
  createdAt DateTime @default(now())
}

/// Short-lived OTPs for dashboard login.
model DashboardOtp {
  id          String   @id @default(cuid())
  phoneNumber String   @unique
  requestId      String
  requestKeyHash String
  actionTokenHash String
  status         String
  createdAt      DateTime @default(now())
  expiresAt      BigInt?
  confirmedAt    DateTime?
}

/// Cumulative per-command invocation counter.
model CommandUsage {
  id      String @id @default(cuid())
  command String @unique
  count   Int    @default(0)
}

/// Tracks users who received messages while they were offline.
model OfflineUser {
  id          String   @id @default(cuid())
  participant String   @unique
  date        BigInt
}

// Used for dashboard-settings.json and dashboard-commands-cache.json.
// `key` is a logical name; `value` is a JSON blob.

model DashboardKV {
  id          Int      @id @default(autoincrement())
  key         String
  sessionName String   @default("main")
  value       String
  updatedAt   DateTime @updatedAt

  @@unique([key, sessionName], name: "key_sessionName")
}

/// Persisted Werewolf game sessions so in-flight games survive a bot
/// restart. `state` holds the whole Session serialized as JSON.
model WerewolfSession {
  id        String   @id @default(cuid())
  roomId    String   @unique
  phase     String
  state     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Persisted sub-bot instances (flags, role, pairNumber, isActive).
model BotInstance {
  id          String   @id @default(cuid())
  sessionName String   @unique
  flags       String   @default("{}")
  role        String   @default("sub")
  pairNumber  String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
